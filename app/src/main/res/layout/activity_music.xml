<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    tools:context=".ui.theme.activity.MusicActivity">

    <!-- Music Image -->
    <ImageView
        android:id="@+id/ivMusic"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_marginTop="92dp"
        android:contentDescription="Music image"
        android:scaleType="centerCrop"
        android:src="@drawable/music_img"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Seek Bar Image -->
    <ImageView
        android:id="@+id/ivline"
        android:layout_width="wrap_content"
        android:layout_height="100dp"
        android:layout_marginTop="16dp"
        android:contentDescription="Music progress"
        android:src="@drawable/seek_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivMusic" />

    <!-- Song Name -->
    <TextView
        android:id="@+id/tvSongName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="My Song"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivline" />

    <!-- Play -->
    <Button
        android:id="@+id/btnstartmusic"
        android:layout_width="140dp"
        android:layout_height="55dp"
        android:layout_marginTop="28dp"
        android:backgroundTint="#4CAF50"
        android:text="▶ Play"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@id/btnstopmusic"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSongName" />

    <!-- Stop -->
    <Button
        android:id="@+id/btnstopmusic"
        android:layout_width="140dp"
        android:layout_height="55dp"
        android:layout_marginStart="16dp"
        android:backgroundTint="#F44336"
        android:text="■ Stop"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnstartmusic"
        app:layout_constraintTop_toTopOf="@id/btnstartmusic" />

</androidx.constraintlayout.widget.ConstraintLayout>